model Image {
  serviceImages        Service[] @relation("ServiceImage")
  servicePosters       Service[] @relation("ServicePoster")
  servicePreviews      Service[] @relation("ServicePreview")
  serviceIcons         Service[] @relation("ServiceIcon")
  serviceCategoryIcons Service[] @relation("ServiceCategoryIcon")
}

model Service {
  imageId        String? @db.Uuid @map("image_id")
  posterId       String? @db.Uuid @map("poster_id")
  previewId      String? @db.Uuid @map("preview_id")
  iconId         String? @db.Uuid @map("icon_id")
  categoryIconId String? @db.Uuid @map("category_icon_id")

  image Image? @relation(
    "ServiceImage",
    fields: [imageId],
    references: [id]
  )

  poster Image? @relation(
    "ServicePoster",
    fields: [posterId],
    references: [id]
  )

  preview Image? @relation(
    "ServicePreview",
    fields: [previewId],
    references: [id]
  )

  icon Image? @relation(
    "ServiceIcon",
    fields: [iconId],
    references: [id]
  )

  categoryIcon Image? @relation(
    "ServiceCategoryIcon",
    fields: [categoryIconId],
    references: [id]
  )
}