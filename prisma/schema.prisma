// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  draft
  published

  @@map("publication_status")
}

enum ActionType {
  primary
  secondary

  @@map("action_type")
}

model Project {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String            @unique @db.Text
  title               String            @db.Text
  shortDescription    String?           @map("short_description") @db.Text
  description         String?           @db.Text
  sortOrder           Int?              @map("sort_order")
  imageId             String?           @unique @map("image_id") @db.Uuid
  posterId            String?           @unique @map("poster_id") @db.Uuid
  previewId           String?           @unique @map("preview_id") @db.Uuid
  iconId              String?           @unique @map("icon_id") @db.Uuid
  isMain              Boolean           @default(false) @map("is_main")
  isActive            Boolean           @default(true) @map("is_active")
  categoryIsAttention Boolean           @default(false) @map("category_is_attention")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publicationStatus   PublicationStatus @default(draft) @map("publication_status")

  actions Action[]

  image   Image? @relation("ProjectImage", fields: [imageId], references: [id], onDelete: Restrict)
  poster  Image? @relation("ProjectPoster", fields: [posterId], references: [id], onDelete: SetNull)
  preview Image? @relation("ProjectPreview", fields: [previewId], references: [id], onDelete: SetNull)
  icon    Image? @relation("ProjectIcon", fields: [iconId], references: [id], onDelete: SetNull)

  categories ProjectCategory[]

  photos Photo[]

  characteristics Characteristic[]

  mediaMentions ProjectMediaMention[]

  events Event[]

  persons ProjectPerson[]

  @@map("project")
}

model Service {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique @db.Text
  title             String            @db.Text
  shortDescription  String?           @map("short_description") @db.Text
  description       String?           @db.Text
  sortOrder         Int?              @map("sort_order")
  imageId           String?           @unique @map("image_id") @db.Uuid
  posterId          String?           @unique @map("poster_id") @db.Uuid
  previewId         String?           @unique @map("preview_id") @db.Uuid
  iconId            String?           @unique @map("icon_id") @db.Uuid
  categoryIconId    String?           @unique @map("category_icon_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publicationStatus PublicationStatus @default(draft) @map("publication_status")

  image        Image? @relation("ServiceImage", fields: [imageId], references: [id], onDelete: Restrict)
  poster       Image? @relation("ServicePoster", fields: [posterId], references: [id], onDelete: SetNull)
  preview      Image? @relation("ServicePreview", fields: [previewId], references: [id], onDelete: SetNull)
  icon         Image? @relation("ServiceIcon", fields: [iconId], references: [id], onDelete: SetNull)
  categoryIcon Image? @relation("ServiceCategoryIcon", fields: [categoryIconId], references: [id], onDelete: Restrict)

  actions Action[]

  photos Photo[]

  characteristics Characteristic[]

  cta CTA?

  persons ServicePerson[]

  @@map("service")
}

model Person {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique @db.Text
  title             String            @db.Text
  shortDescription  String?           @map("short_description") @db.Text
  description       String?           @db.Text
  sortOrder         Int?              @map("sort_order")
  imageId           String?           @unique @map("image_id") @db.Uuid
  posterId          String?           @unique @map("poster_id") @db.Uuid
  previewId         String?           @unique @map("preview_id") @db.Uuid
  iconId            String?           @unique @map("icon_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publicationStatus PublicationStatus @default(draft) @map("publication_status")

  image   Image? @relation("PersonImage", fields: [imageId], references: [id], onDelete: Restrict)
  poster  Image? @relation("PersonPoster", fields: [posterId], references: [id], onDelete: SetNull)
  preview Image? @relation("PersonPreview", fields: [previewId], references: [id], onDelete: SetNull)
  icon    Image? @relation("PersonIcon", fields: [iconId], references: [id], onDelete: SetNull)

  categories PersonCategory[]

  photos Photo[]

  socialMedias SocialMedia[]

  mediaMentions PersonMediaMention[]

  projects ProjectPerson[]
  services ServicePerson[]

  @@map("person")
}

model Product {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String            @unique @db.Text
  title                   String            @db.Text
  shortDescription        String?           @map("short_description") @db.Text
  description             String?           @db.Text
  price                   Decimal?          @db.Decimal(10, 2)
  sortOrder               Int?              @map("sort_order")
  imageId                 String?           @unique @map("image_id") @db.Uuid
  posterId                String?           @unique @map("poster_id") @db.Uuid
  previewId               String?           @unique @map("preview_id") @db.Uuid
  iconId                  String?           @unique @map("icon_id") @db.Uuid
  requiresCharacteristics Boolean           @default(false) @map("requires_characteristics")
  isAvailable             Boolean           @default(true) @map("is_available")
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publicationStatus       PublicationStatus @default(draft) @map("publication_status")

  image   Image? @relation("ProductImage", fields: [imageId], references: [id], onDelete: Restrict)
  poster  Image? @relation("ProductPoster", fields: [posterId], references: [id], onDelete: SetNull)
  preview Image? @relation("ProductPreview", fields: [previewId], references: [id], onDelete: SetNull)
  icon    Image? @relation("ProductIcon", fields: [iconId], references: [id], onDelete: SetNull)

  actions Action[]

  categories ProductCategory[]

  photos Photo[]

  characteristicLists ProductCharacteristicList[]

  @@map("product")
}

model Category {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iconId String? @map("icon_id") @db.Uuid
  text   String  @db.Text

  icon Image? @relation(fields: [iconId], references: [id], onDelete: SetNull)

  projectCategories ProjectCategory[]
  personCategories  PersonCategory[]
  productCategories ProductCategory[]

  @@map("category")
}

model ProjectCategory {
  projectId  String @map("project_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId], map: "idx_project_category_category_id")
  @@map("project_category")
}

model PersonCategory {
  personId   String @map("person_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([personId, categoryId])
  @@index([categoryId], map: "idx_person_category_category_id")
  @@map("person_category")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId], map: "idx_product_category_category_id")
  @@map("product_category")
}

model Photo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  serviceId String? @map("service_id") @db.Uuid
  personId  String? @map("person_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  imageId   String  @map("image_id") @db.Uuid

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  person  Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   Image    @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([imageId], map: "idx_photo_image_id")
  @@map("photo")
}

model Action {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?    @map("project_id") @db.Uuid
  serviceId String?    @map("service_id") @db.Uuid
  productId String?    @map("product_id") @db.Uuid
  iconId    String?    @map("icon_id") @db.Uuid
  url       String     @db.Text
  text      String     @db.Text
  type      ActionType

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  icon    Image?   @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@map("action")
}

model SocialMedia {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String  @map("person_id") @db.Uuid
  iconId   String? @map("icon_id") @db.Uuid
  url      String  @db.Text
  text     String  @db.Text

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  icon   Image? @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@index([personId], map: "idx_social_media_person_id")
  @@map("social_media")
}

model Characteristic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  iconId    String?  @map("icon_id") @db.Uuid
  title     String   @db.Text
  value     String[] @db.Text

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  icon    Image?   @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@map("characteristic")
}

model MediaMention {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId String @map("image_id") @db.Uuid
  title   String @db.Text
  text    String @db.Text
  url     String @db.Text

  image Image @relation(fields: [imageId], references: [id], onDelete: Restrict)

  projectMediaMentions ProjectMediaMention[]
  personMediaMentions  PersonMediaMention[]

  @@index([imageId], map: "idx_media_mention_image_id")
  @@map("media_mention")
}

model ProjectMediaMention {
  projectId      String @map("project_id") @db.Uuid
  mediaMentionId String @map("media_mention_id") @db.Uuid

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaMention MediaMention @relation(fields: [mediaMentionId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaMentionId])
  @@index([mediaMentionId], map: "idx_project_media_mention_media_mention_id")
  @@map("project_media_mention")
}

model PersonMediaMention {
  personId       String @map("person_id") @db.Uuid
  mediaMentionId String @map("media_mention_id") @db.Uuid

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  mediaMention MediaMention @relation(fields: [mediaMentionId], references: [id], onDelete: Cascade)

  @@id([personId, mediaMentionId])
  @@index([mediaMentionId], map: "idx_person_media_mention_media_mention_id")
  @@map("person_media_mention")
}

model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  place     String   @db.Text
  dateTime  DateTime @map("date_time") @db.Timestamptz
  label     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_event_project_id")
  @@map("event")
}

model CTA {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String  @unique @map("service_id") @db.Uuid
  iconId    String? @map("icon_id") @db.Uuid
  text      String? @db.Text

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  icon    Image?  @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@map("cta")
}

model ProjectPerson {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  personId  String  @map("person_id") @db.Uuid
  role      String? @db.Text
  extra     String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_person_project_id")
  @@index([personId], map: "idx_project_person_person_id")
  @@map("project_person")
}

model ServicePerson {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  personId  String  @map("person_id") @db.Uuid
  role      String? @db.Text
  extra     String? @db.Text

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "idx_service_person_service_id")
  @@index([personId], map: "idx_service_person_person_id")
  @@map("service_person")
}

model ProductCharacteristicList {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  title     String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  characteristics ProductCharacteristic[]

  @@index([productId], map: "idx_product_characteristic_list_product_id")
  @@map("product_characteristic_list")
}

model ProductCharacteristic {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characteristicListId String  @map("characteristic_list_id") @db.Uuid
  color                String? @db.Text
  text                 String? @db.Text

  characteristicList ProductCharacteristicList @relation(fields: [characteristicListId], references: [id], onDelete: Cascade)

  @@index([characteristicListId], map: "idx_product_characteristic_characteristic_list_id")
  @@map("product_characteristic")
}

model Image {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey String   @unique @map("storage_key") @db.Text
  mimeType   String?  @map("mime_type") @db.Text
  width      Int?
  height     Int?
  size       BigInt?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actions Action[]

  projectImage   Project? @relation("ProjectImage")
  projectPoster  Project? @relation("ProjectPoster")
  projectPreview Project? @relation("ProjectPreview")
  projectIcon    Project? @relation("ProjectIcon")

  serviceImage        Service? @relation("ServiceImage")
  servicePoster       Service? @relation("ServicePoster")
  servicePreview      Service? @relation("ServicePreview")
  serviceIcon         Service? @relation("ServiceIcon")
  serviceCategoryIcon Service? @relation("ServiceCategoryIcon")

  personImage   Person? @relation("PersonImage")
  personPoster  Person? @relation("PersonPoster")
  personPreview Person? @relation("PersonPreview")
  personIcon    Person? @relation("PersonIcon")

  productImage   Product? @relation("ProductImage")
  productPoster  Product? @relation("ProductPoster")
  productPreview Product? @relation("ProductPreview")
  productIcon    Product? @relation("ProductIcon")

  categoryIcons Category[]

  photos Photo[]

  characteristicIcons Characteristic[]

  socialMediaIcons SocialMedia[]

  mediaMentions MediaMention[]

  ctaIcons CTA[]

  @@map("image")
}
