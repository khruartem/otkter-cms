// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  draft
  published
}

enum ActionType {
  primary
  secondary
}

model Project {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String            @unique @db.Text
  title               String            @db.Text
  shortDescription    String?           @map("short_description") @db.Text
  description         String?           @db.Text
  sortOrder           Int?              @map("sort_order")
  imageId             String?           @unique @map("image_id") @db.Uuid
  posterId            String?           @unique @map("poster_id") @db.Uuid
  previewId           String?           @unique @map("preview_id") @db.Uuid
  iconId              String?           @unique @map("icon_id") @db.Uuid
  isMain              Boolean           @default(false) @map("is_main")
  isActive            Boolean           @default(true) @map("is_active")
  categoryIsAttention Boolean           @default(false) @map("category_is_attention")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publicationStatus   PublicationStatus @default(draft) @map("publication_status")

  actions Action[] @relation("ProjectActions")

  image   Image? @relation("ProjectImage", fields: [imageId], references: [id], onDelete: Restrict)
  poster  Image? @relation("ProjectPoster", fields: [posterId], references: [id], onDelete: SetNull)
  preview Image? @relation("ProjectPreview", fields: [previewId], references: [id], onDelete: SetNull)
  icon    Image? @relation("ProjectIcon", fields: [iconId], references: [id], onDelete: SetNull)

  projectCategories ProjectCategory[]

  photos Photo[] @relation("ProjectPhotos")

  characteristics Characteristic[] @relation("ProjectCharacteristics")

  projectMediaMentions ProjectMediaMention[]

  @@map("project")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actions Action[] @relation("ServiceActions")

  photos Photo[] @relation("ServicePhotos")

  characteristics Characteristic[] @relation("ServiceCharacteristics")

  @@map("service")
}

model Person {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  personCategories PersonCategory[]

  photos Photo[] @relation("PersonPhotos")

  socialMedias SocialMedia[] @relation("PersonSocialMedias")

  personMediaMentions PersonMediaMention[]

  @@map("person")
}

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actions Action[] @relation("ProductActions")

  productCategories ProductCategory[]

  photos Photo[] @relation("ProductPhotos")

  @@map("product")
}

model Category {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iconId String? @map("icon_id") @db.Uuid
  text   String  @db.Text

  icon Image? @relation("CategoryIcon", fields: [iconId], references: [id], onDelete: SetNull)

  projectCategories ProjectCategory[]
  personCategories  PersonCategory[]
  productCategories ProductCategory[]

  @@map("category")
}

model ProjectCategory {
  projectId  String @map("project_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId], map: "idx_project_category_category_id")
  @@map("project_category")
}

model PersonCategory {
  personId   String @map("person_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([personId, categoryId])
  @@index([categoryId], map: "idx_person_category_category_id")
  @@map("person_category")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId], map: "idx_product_category_category_id")
  @@map("product_category")
}

model Photo {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  serviceId String? @map("service_id") @db.Uuid
  personId  String? @map("person_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  imageId   String  @map("image_id") @db.Uuid

  project Project? @relation("ProjectPhotos", fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation("ServicePhotos", fields: [serviceId], references: [id], onDelete: Cascade)
  person  Person?  @relation("PersonPhotos", fields: [personId], references: [id], onDelete: Cascade)
  product Product? @relation("ProductPhotos", fields: [productId], references: [id], onDelete: Cascade)
  image   Image    @relation("PhotoImage", fields: [imageId], references: [id], onDelete: Restrict)

  @@index([imageId], map: "idx_photo_image_id")
  @@map("photo")
}

model Action {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?    @map("project_id") @db.Uuid
  serviceId String?    @map("service_id") @db.Uuid
  productId String?    @map("product_id") @db.Uuid
  iconId    String?    @map("icon_id") @db.Uuid
  url       String     @db.Text
  text      String     @db.Text
  type      ActionType

  project Project? @relation("ProjectActions", fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation("ServiceActions", fields: [serviceId], references: [id], onDelete: Cascade)
  product Product? @relation("ProductActions", fields: [productId], references: [id], onDelete: Cascade)
  icon    Image?   @relation("ActionIcon", fields: [iconId], references: [id], onDelete: SetNull)

  @@map("action")
}

model SocialMedia {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String  @map("person_id") @db.Uuid
  iconId   String? @map("icon_id") @db.Uuid
  url      String  @db.Text
  text     String  @db.Text

  person Person @relation("PersonSocialMedias", fields: [personId], references: [id], onDelete: Cascade)
  icon   Image? @relation("SocialMediaIcon", fields: [iconId], references: [id], onDelete: SetNull)

  @@index([personId], map: "idx_social_media_person_id")
  @@map("social_media")
}

model Characteristic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  iconId    String?  @map("icon_id") @db.Uuid
  title     String   @db.Text
  value     String[] @db.Text

  project Project? @relation("ProjectCharacteristics", fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation("ServiceCharacteristics", fields: [serviceId], references: [id], onDelete: Cascade)
  icon    Image?   @relation("CharacteristicIcon", fields: [iconId], references: [id], onDelete: SetNull)

  @@map("characteristic")
}

model MediaMention {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId String @map("image_id") @db.Uuid
  title   String @db.Text
  text    String @db.Text
  url     String @db.Text

  image Image @relation("MediaMentionImage", fields: [imageId], references: [id], onDelete: Restrict)

  projectMediaMentions ProjectMediaMention[]
  personMediaMentions  PersonMediaMention[]

  @@index([imageId], map: "idx_media_mention_image_id")
  @@map("media_mention")
}

model ProjectMediaMention {
  projectId      String @map("project_id") @db.Uuid
  mediaMentionId String @map("media_mention_id") @db.Uuid

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaMention MediaMention @relation(fields: [mediaMentionId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaMentionId])
  @@index([mediaMentionId], map: "idx_project_media_mention_media_mention_id")
  @@map("project_media_mention")
}

model PersonMediaMention {
  personId       String @map("person_id") @db.Uuid
  mediaMentionId String @map("media_mention_id") @db.Uuid

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  mediaMention MediaMention @relation(fields: [mediaMentionId], references: [id], onDelete: Cascade)

  @@id([personId, mediaMentionId])
  @@index([mediaMentionId], map: "idx_person_media_mention_media_mention_id")
  @@map("person_media_mention")
}

model Image {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey String   @unique @map("storage_key") @db.Text
  mimeType   String?  @map("mime_type") @db.Text
  width      Int?
  height     Int?
  size       BigInt?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actions Action[] @relation("ActionIcon")

  projectImage   Project? @relation("ProjectImage")
  projectPoster  Project? @relation("ProjectPoster")
  projectPreview Project? @relation("ProjectPreview")
  projectIcon    Project? @relation("ProjectIcon")

  categoryIcons Category[] @relation("CategoryIcon")

  photos Photo[] @relation("PhotoImage")

  characteristicIcons Characteristic[] @relation("CharacteristicIcon")

  socialMediaIcons SocialMedia[] @relation("SocialMediaIcon")

  mediaMention MediaMention[] @relation("MediaMentionImage")

  @@map("image")
}
