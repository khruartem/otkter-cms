// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActionType {
  primary
  secondary
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actions Action[] @relation("ProjectActions")

  @@map("project")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actions Action[] @relation("ServiceActions")

  @@map("service")
}

model Person {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("person")
}

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actions Action[] @relation("ProductActions")

  @@map("product")
}

model Action {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?    @map("project_id") @db.Uuid
  serviceId String?    @map("service_id") @db.Uuid
  productId String?    @map("product_id") @db.Uuid
  iconId    String?    @map("icon_id") @db.Uuid
  url       String     @db.Text
  text      String     @db.Text
  type      ActionType

  project Project? @relation("ProjectActions", fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation("ServiceActions", fields: [serviceId], references: [id], onDelete: Cascade)
  product Product? @relation("ProductActions", fields: [productId], references: [id], onDelete: Cascade)
  icon    Image?   @relation("ActionIcon", fields: [iconId], references: [id], onDelete: SetNull)

  @@map("action")
}

model Image {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey String   @unique @map("storage_key") @db.Text
  mimeType   String?  @map("mime_type") @db.Text
  width      Int?
  height     Int?
  size       BigInt?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actions Action[] @relation("ActionIcon")

  @@map("image")
}
